# Public, required in production. Canonical HTTPS origin with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase project settings. Safe in browser code only when RLS is correct.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY privileged key. Never expose, commit, log, or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# TEST-ONLY non-production accounts. Keep values in ignored local/CI secret storage.
# These are read by Playwright, never by application code or a browser bundle.
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
SUPABASE_TEST_NON_ADMIN_EMAIL=
SUPABASE_TEST_NON_ADMIN_PASSWORD=

# Public booking/contact destinations. Leave blank until the complete value is verified.
NEXT_PUBLIC_AIRBNB_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Server/build feature switches. Rebuild after changing analytics. Contact
# inquiries are runtime-evaluated, disabled unless exactly true, and require
# owner approval, the applied schema, service key, and retention process.
ANALYTICS_ENABLED=true
CONTACT_INQUIRY_ENABLED=false
